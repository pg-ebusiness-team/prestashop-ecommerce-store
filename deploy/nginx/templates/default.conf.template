server {
    listen 80;
    server_name _;

    return 301 https://${SERVER_NAME}:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://shop:80;

        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port  ${HTTPS_PORT};

        # Apache (mod_dir) dopisuje "/" do katalogów przekierowaniem zbudowanym z Host i schematu http; przepisz na https w celu uniknięcia błędu 400 nginx (patrz Docker_Docs.md)
        proxy_redirect http://$http_host/ https://$http_host/;
    }
}