# Konfiguracja Bazy Danych
MYSQL_ROOT_PASSWORD=example_root_password
MYSQL_DATABASE=prestashop
MYSQL_USER=prestashop_user
MYSQL_PASSWORD=example_password

# Konfiguracja adresu sklepu i reverse proxy (nginx)
HTTP_PORT=8080
HTTPS_PORT=8443
SERVER_NAME=localhost

# Konfiguracja panelu admina PrestaShop
ADMIN_MAIL=admin@example.com
ADMIN_PASSWD=example_admin_password
ADMIN_FOLDER=folderexample

# Konfiguracja Webservice API PrestaShop
PS_API_KEY=your_api_key_here

# Konfiguracja Mailpit
MAILPIT_PORT=8025

# Weryfikacja certyfikatu SSL (0 = wyłączona, 1 = włączona)
PS_VERIFY_SSL=0

# Mapowanie stawek VAT na ID grup reguł podatkowych PrestaShop
# ID z domyślnej polskiej instalacji (1 = 23%, 2 = 8%, 3 = 5%, 4 = 0%); błędne ID przypisze produktom złą stawkę VAT.
# Sprawdź w panelu: Międzynarodowe -> Podatki -> Reguły podatków
PS_TAX_RULES_GROUP_MAP={"0":4,"5":3,"8":2,"23":1}

# Archiwum zdjęć produktów z zakładki Releases (opcjonalnie; domyślny adres jest w makefile, make photos)
# PHOTOS_RELEASE_URL=https://github.com/pg-ebusiness-team/prestashop-ecommerce-store/releases/download/photos_v0.1/product_photos.zip
